// removeBackupData 함수 정의: 백업 데이터 제거 함수
def removeBackupData(file_path, keep_count) {
    // file_path 경로의 파일 개수 확인
    def file_count_str = sh (
        script: 'ls $file_path | wc -l',
        returnStdout: true
    ).trim()
    // 파일 개수를 정수형으로 변환
    def file_count = Integer.parseInt(file_count_str)
    // 파일 개수가 보관할 개수보다 많으면 실행
    if (file_count > keep_count) {
        // 오래된 파일 목록을 시간 순서로 정렬하여 가져옴
        def files = sh (
        // 파일 목록을 시간 역순(-t) 및 역순(-r)으로 정렬하여 쉘 명령어로 가져옴
            script: 'ls $file_path -t -r',
            // 쉘 명령어의 출력 결과를 문자열로 반환
            returnStdout: true
        )
        // 파일 목록을 배열로 분리
        def file_list = files.split('\\r?\\n')
        // 파일 이름을 저장할 변수를 초기화
        def file_name = ''
        // 보관할 파일 개수를 제외한 나머지 파일 삭제
        for (int inx = 0; inx < (file_count - keep_count); inx++) {
            // 삭제할 파일 이름을 리스트에서 가져옴
            file_name = file_list[inx].trim()
            // 삭제할 파일 이름을 로그로 출력
            echo 'removed file name : [$file_name]'
            // 파일 삭제 명령어 실행
            sh '/usr/bin/rm -rf $file_path/$file_name'
        }
	}
}

node {
    // 현재 워크스페이스 경로 저장
    def workspace = pwd()
    // Jenkins Job 이름 저장
    def jobName = JOB_NAME
    // Git 저장소 URL 설정
    def appGitUrl = 'http://192.168.56.1:40100'
    // Git 브랜치 설정
    def appGitBranch = 'develop'
    // 보관할 파일 개수 설정
    def filesToKeep = 3

    stage('Jenkins Start') {
        // 현재 워크스페이스 경로 출력
        echo workspace
        // 워크스페이스 정리
        cleanWs()
    }

     stage('Gitlab Checkout') {
	    try {
	        // 워크스페이스 정리: 작업 공간의 임시 파일 및 이전 빌드 데이터를 정리합니다.
	        step([$class: 'WsCleanup'])
	        
	        // Git에서 소스 코드 체크아웃
	        checkout([
	            // GitSCM 클래스 사용하여 Git 레포지토리에서 소스 코드 가져옴
	            $class: 'GitSCM',
	            // 체크아웃할 브랜치 지정
	            branches: [[name: appGitBranch]],
	            // 서브모듈 설정 생성을 비활성화
	            doGenerateSubmoduleConfigurations: false,
	            // 이전 체크아웃을 정리하고 새로 체크아웃
	            extensions: [[$class: 'CleanCheckout']],
	            // 서브모듈 설정을 비워 둠
	            submoduleCfg: [],
	            // 원격 저장소 설정
	            userRemoteConfigs: [[
	                // 자격 증명 ID 설정
	                credentialsId: 'jenkins',
	                // 레포지토리의 브랜치와 병합 요청을 모두 가져오기 위한 refspec 설정
	                refspec: '+refs/heads/*:refs/remotes/origin/* +refs/merge-requests/*/head:refs/remotes/origin/merge-requests/*',
	                // Git 리포지토리 URL 설정
	                url: appGitUrl + appGitRepo
	            ]]
	        ])
	    } catch (err) {
	        // Git 체크아웃 실패 시 에러 메시지 출력
	        buildDescription '[Error Occurred(Git Checkout Failed) :: ' + err.getMessage() + ']'
	        // 예외 발생 시 예외 메시지를 포함하여 새로운 예외를 발생시킴
	        throw new Exception(err.getMessage())
	    }
	}

    stage('Maven Build') {
	    try {
	        // Maven 환경 변수 설정 및 빌드 실행
	        // withEnv는 제공된 환경 변수로 명령을 실행할 때 사용
	        withEnv(["MAVEN_HOME=${tool 'MAVEN_HOME'}"
	                ,"JAVA_HOME=${tool 'openjdk-17'}"]) { // 특정 버전의 java로 빌드 시, Jenkins 관리 > Tool에서 자바 등록 후에 해당 값 설정
	            // Maven 빌드를 수행하는 쉘 명령을 실행
	            // -X: 디버그 출력
	            // -Dmaven.test.skip=true: 테스트 건너뛰기
	            // -U: 종속성 강제 업데이트
	            sh '${MAVEN_HOME}/bin/mvn clean deploy -X -Dmaven.test.skip=true -U'
	        }
	    } catch (err) {
	        // Maven 빌드 실패 시 에러 메시지 출력
	        // buildDescription으로 빌드 설명을 업데이트
	        buildDescription '[Error Occurred(Maven Build Failed) :: ' + err.getMessage() + ']'
	        // 예외를 발생시켜 빌드 실패로 표시
	        throw new Exception(err.getMessage())
	    }
	}
	
    stage('Cleanup') {
        // 임시 워크스페이스 디렉토리 정리
        dir('${env.WORKSPACE}@tmp') {
            deleteDir()
        }
    }

    stage('Complete') {
        // 작업 완료 메시지 출력
        echo 'Job Complete'
    }
}
