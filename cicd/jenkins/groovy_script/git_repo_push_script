// dev 브랜치 소스를 체크 아웃한 뒤, stg/prd 브랜치로 push하는 스크립트

// 젠킨스 파이프라인 시작
node {
	// 현재 작업 디렉토리
    def workspace = pwd()
    
    // 원격 서버 설정을 위한 맵
    def remote = [:]
    // SSH 포트 설정
    remote.port = 20022
    // 모든 호스트 허용 설정
    remote.allowAnyHosts = true
    
    // GitLab URL 설정
    def appGitUrl = 'http://192.168.56.1:40100'
    // GitLab Repository 경로(git 경로와 jobName을 맞추면 모두 변수 처리 가능)
    def appRepo = '/moj/mojda.git'
    // GitLab 브랜치 설정(git 경로와 jobName을 맞추면 모두 변수 처리 가능)
    def appGitBranch = 'dev' 
    
    // Jenkins 시작 단계
    stage('Jenkins Start'){
    	// 현재 작업 디렉토리 출력
        echo workspace
        // 작업 디렉토리 정리
        cleanWs()
    }
    
    // GitLab 체크아웃 단계
    stage('Gitlab Checkout'){
        try {
            step([$class: 'WsCleanup']) // 작업 디렉토리 정리
            checkout([
                $class: 'GitSCM',
                branches: [[name: appGitBranch]], // 체크아웃할 브랜치 설정
                doGenerateSubmoduleConfigurations: false, // 서브 모듈 설정 안함
                extensions: [[$class: 'CleanCheckout']], // 클린 체크아웃
                submoduleCfg: [],
                userRemoteConfigs: [[
                    credentialsId: 'jenkins', // GitLab 접근 자격 증명 ID
                    refspec: '+refs/heads/*:refs/remotes/origin/* +refs/merge-requests/*/head:refs/remotes/origin/merge-requests/*',
                    url: appGitUrl + appRepo // GitLab URL 설정
                ]]
            ])
        } catch (err) {
        	// 에러 발생 시 설명 추가
            buildDescription "[Error Occurred(${env.STAGE_NAME} Failed) :: ${err.getMessage()}]"
            // 에러 발생 시 예외 던지기
            throw new Exception(err.getMessage())
        }
    }

    // Push dev branch to another branch
    stage('Push to Anothers') {
        try {
        	withCredentials([usernamePassword(credentialsId: 'jenkins', passwordVariable: 'password', usernameVariable: 'userName')]) {
        		dir("${workspace}") {
        			sh """
        				git remote set-url origin http://${username}:${password}@localhost:8084/${gitAppRepo}
        				git remove -v
        				git fetch origin
        				git switch dev
        				git push origin dev:stg -f
        				git push origin dev:prd -f
        			"""
        		}
        	}
        } catch (err) {
            // 에러 발생 시 설명 추가
            buildDescription "[Error Occurred(${env.STAGE_NAME} Failed) :: ${err.getMessage()}]"
            // 에러 발생 시 예외 던지기
            throw new Exception(err.getMessage()) 
        }
    }
    
    // 젠킨스 빌드 파일 정리 단계
    stage('Cleanup') {
        // 작업 공간의 임시 파일 삭제
        dir(‘${env.WORKSPACE}@tmp’) {
        	// 임시 디렉토리 삭제
            deleteDir()
        }
    }
    
    // 완료 단계
    stage('Complete') {
    	// 작업 완료 메시지 출력
        echo 'Job Complete'
    }
}