            throw new Exception(err.getMessage()) 
        }
    }
    
	// WEB 서버 배포 및 백업 단계에 사용할 자격 증명 설정
	withCredentials([usernamePassword(credentialsId: 'webtob', passwordVariable: 'password', usernameVariable: 'userName')]) {
