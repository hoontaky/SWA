	    def ozr_deploy_path = "/app/jeus/online/${mwInsName}/WEB-INF/repository_files"
	    // 배포할 OZ Report 파일 이름 설정
	    def ozr_file = "${pjtName}-ozr.tgz"
	    
	    // OZ Report 서버 IP 리스트를 순회하며 배포 진행
	    for (int inx = 1; inx <= ozIpList.size(); inx++) {
	        // IP 주소가 비어있는지 확인하고 비어있으면 건너뜀
	        if (ozIpList[inx - 1] == '' || ozIpList[inx - 1].length() == 0) {
	            continue
	        }
	        
	        // 현재 순번의 OZ Report 서버 IP 주소 설정
	        remote.host = ozIpList[inx - 1]
            
            // 보고서 서버 배포 단계
            stage("RPT-${inx} Deploy") {
                try {
                    // 배포 경로가 존재하는지 확인
                    def ozDeployPathRes = sshCommand remote: remote, command: "test -d ${ozr_deploy_path} && echo 1 || echo 2"
                    // 경로가 없으면 생성
                    if (ozDeployPathRes == '2') {
                        sshCommand remote: remote, command: "mkdir -p ${ozr_deploy_path}"
                    }
                    // 기존 파일 삭제
                    sshCommand remote: remote, command: "/usr/bin/rm -rf ${ozr_deploy_path}/${pjtName}/*"
                    // 빌드 파일 업로드
                    sshPut remote: remote, from: "${workspace}/target/${ozr_file}", into: "${ozr_deploy_path}/"
                    // 빌드 파일 압축 해제
                    sshCommand remote: remote, command: "/usr/bin/tar -xvf ${ozr_deploy_path}/${ozr_file} -C ${ozr_deploy_path}"
                    // 업로드한 빌드 파일 삭제
                    sshCommand remote: remote, command: "/usr/bin/rm -rf ${ozr_deploy_path}/${ozr_file}"
                } catch (err) {
                    // 에러 발생 시 설명 추가
                    buildDescription "[Error Occurred(Report Deploy Failed) :: ${err.getMessage()}]"
                    // 에러 발생 시 예외 던지기
                    throw new Exception(err.getMessage()) 
                }
            }
        }
    }
    
    // 젠킨스 빌드 파일 정리 단계
    stage('Cleanup') {
        // 작업 공간의 임시 파일 삭제
        dir("${env.WORKSPACE}@tmp") {
            // 임시 디렉토리 삭제
            deleteDir()
        }
    }
    
    // 완료 단계
    stage('Complete') {
        // 작업 완료 메시지 출력
        echo 'Job Complete'
    }
}