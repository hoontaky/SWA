    // 보고서 서버 IP 리스트
    def ozIpList = ['192.168.58.1', '192.168.58.2']
    // Middleware Instance 이름
    def mwInsName = 'momspda'
    // 도메인 이름
    def domainName = 'iop'
    // WAS Server Path
    def wasServerPath = "/app/lena/AppServer/servers/${grpName}App"
    // WAS Health Check Retry Count
    def wasCheckCount = 5
    
    // Websquare Build Options
    // 0: minify
    // 1: 주석 공백 제거
    // 2: 주석, 고백제거, 로컬 변수 치환
    
    // JS 처리 값
    def jsValue = '0'
    // CSS 처리 값
    def cssValue = '1'
    // JS 생성 횟수
    def genJsCnt = 2
    
    // 백업 파일 보관 개수
    def filesToKeep = 3
    
    // Jenkins 시작 단계
    stage("Jenkins Start"){
    	sh "whoami"
    	// 현재 작업 디렉토리 출력
        echo workspace
        // 작업 디렉토리 정리
        cleanWs()
    }
    
    // GitLab 체크아웃 단계
    stage("Git Checkout"){
        try {
        	// 작업 디렉토리 정리
            step([$class: 'WsCleanup'])
            checkout([
                $class: 'GitSCM',
                // 체크아웃할 브랜치 설정
                branches: [[name: appGitBranch]],
                // 서브 모듈 설정 안함
                doGenerateSubmoduleConfigurations: false,
                // 클린 체크아웃
                extensions: [[$class: 'CleanCheckout']],
                submoduleCfg: [],
