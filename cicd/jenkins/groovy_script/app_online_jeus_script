	    // 원격 서버 비밀번호 설정
	    remote.password = password
	    
	    // WAS 배포 경로 설정
	    def was_deploy_path = "/app/jeus/online/${mwInsName}"
	    // 배포할 빌드 파일 이름 설정
	    def build_file = "${pjtName}.war"
	    // WAS 서버 IP 리스트를 순회하며 배포 진행
	    for (int inx = 1; inx <= wasIpList.size(); inx++) {
	        // IP 주소가 비어있는지 확인하고 비어있으면 건너뜀
	        if (wasIpList[inx - 1] == '' || wasIpList[inx - 1].length() == 0) {
	            continue
	        }
	        
	        // 현재 순번의 WAS 서버 IP 주소 설정
        	remote.host = wasIpList[inx - 1]
        	
            // WAS 서버 중지 단계
            stage("WAS-${inx} Stop") {
                try {
                    if (envName == 'prd' || envName == 'edu') {
                        // 프로덕션 또는 교육 환경일 때
                        sshCommand remote: remote, command: "source ~/.bash_profile; /sw/jeus/bin/msdown_${mwInsName}0${inx} || true"
                    } else {
