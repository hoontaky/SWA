// Jenkins Job에서 다른 Job을 호출할 때 사용하는 스크립트

node {
    // Jenkins 시작 단계
    stage('Jenkins Start'){
        echo workspace // 현재 작업 디렉토리 출력
        cleanWs() // 작업 디렉토리 정리
    }

    // 다른 JOB 호출
    stage('Call Another Job') {
    	def response = build(
    		job: 'another-job',
    		wait: true, // true이면 동기식 / false이면 비동기식
    		propagate: false // true이면 another-job의 결과에 영향을 받음 / false이면 another-job의 결과에 영향을 받지 않음
    	)
    	
    	if (response.result == 'SUCCESS') {
    		echo ">>>> Another Job Success!!!"
    	} else {
    		echo ">>>> Another Job Failed!!!"
    	}
    }
    
    // 젠킨스 빌드 파일 정리 단계
    stage('Cleanup') {
        // 작업 공간의 임시 파일 삭제
        dir("${env.WORKSPACE}@tmp") {
            deleteDir() // 임시 디렉토리 삭제
        }
    }
    
    // 완료 단계
    stage('Complete') {
        echo 'Job Complete' // 작업 완료 메시지 출력
    }
}