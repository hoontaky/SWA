// 로컬 서버에서 오래된 백업 파일을 제거하는 함수
def removeBackupFile(file_path, keep_count) {
	// Get File Count
	def file_count = sh(script: "ls ${file_path} | wc -l", returnStdout:true).trim().toInteger()
	
	if(file_count > keep_count) {
		def files = sh(script: "ls ${file_path} -t -r", returnStdout: true).trim().split("\n") as List
		
		for(int inx=0; inx < (file_count - keep_count); inx++) {
			sh "/usr/bin/rm -rf ${file_path}/${files[inx].trim()}"
		}
	}
}

node() {
	
	// 현재 작업 디렉토리
    def workspace = pwd()
    // 현재 시간 변수
    def now = new Date()
    // 현재 날짜 변수
    def currentDate = now.format("yyyy-MM-dd-HH-mm-ss", TimeZone.getTimeZone("Asia/Seoul"))
    // Jenkins Job 이름
    def jobName = env.JOB_NAME
    // 환경 이름 추출
    def envName = jobName.split('-')[0]
    // 기관 이름 추출
    def grpName = jobName.split('-')[1]
    // 프로젝트 이름 추출
    def pjtName = jobName.split('-')[2]
    
    // GitLab URL 설정
    def gitIpParam = "${grpName.toUpperCase()}_GIP_IP"
    def appGitIp = env[gitIpParam]
    def appGitUrl = "http://${appGitIp}:40100"
    // GitLab Repository 경로(git 경로와 jobName을 맞추면 모두 변수 처리 가능)
    def appRepo = "/${grpName}/${pjtName}.git"
    // GitLab 브랜치 설정(git 경로와 jobName을 맞추면 모두 변수 처리 가능)
    def appGitBranch = "${envName}"
    
    // Backup Info.
    // Backup File Count
    def filesToKeep = 5
    // Backup File Name
    def backupFileNm = "${pjtName}-${envName}-${currentDate}.tar.gz"
	
	stage("Jenkins Start") {
		echo "start!!!"
	}
	
    // GitLab 체크아웃 단계
    stage("Git Checkout"){
        try {
        	// 작업 디렉토리 정리
            step([$class: 'WsCleanup'])
            checkout([
                $class: 'GitSCM',
                // 체크아웃할 브랜치 설정
                branches: [[name: appGitBranch]],
                // 서브 모듈 설정 안함
                doGenerateSubmoduleConfigurations: false,
                // 클린 체크아웃
                extensions: [[$class: 'CleanCheckout']],
                submoduleCfg: [],
                userRemoteConfigs: [[
                	// GitLab 접근 자격 증명 ID
                    credentialsId: 'jenkins',
                    refspec: '+refs/heads/*:refs/remotes/origin/* +refs/merge-requests/*/head:refs/remotes/origin/merge-requests/*',
                    // GitLab URL 설정
                    url: appGitUrl + appRepo
                ]]
            ])
        } catch (err) {
        	// 에러 발생 시 설명 추가
            buildDescription "[Error Occurred(Git Checkout Failed) :: ${err.getMessage()}]"
            // 에러 발생 시 예외 던지기
            throw new Exception(err.getMessage())
        }
    }
	
	stage("Git Backup") {
		try {
			sh "tar -czvf ${backupFileNm} . || true"
		} catch (err) {
        	// 에러 발생 시 설명 추가
            buildDescription "[Error Occurred(Git Backup Failed) :: ${err.getMessage()}]"
            // 에러 발생 시 예외 던지기
            throw new Exception(err.getMessage())
		}
	}
	
	stage("Move Backup File") {
		try {
			// Check Backup Path
			def fileDir = new File(backupFilePath)
			echo "backupFilePath :: ${backupFilePath}"
			
			if(!fileDir.exists()) {
				sh "mkdir -p ${backupFilePath}"
			}
			
			sh "mv ./${backupFileNm} ${backupFilePath}/${backupFileNm}"
			
			removeBackupFile(backupFilePath, filesToKeep)
		} catch (err) {
        	// 에러 발생 시 설명 추가
            buildDescription "[Error Occurred(Move Backup File Failed) :: ${err.getMessage()}]"
            // 에러 발생 시 예외 던지기
            throw new Exception(err.getMessage())
		}
	}
	
    // 젠킨스 빌드 파일 정리 단계
    stage('Cleanup') {
        // 작업 공간의 임시 파일 삭제
        dir("${env.WORKSPACE}@tmp") {
            // 임시 디렉토리 삭제
            deleteDir()
        }
    }
    
    // 완료 단계
    stage('Complete') {
        // 작업 완료 메시지 출력
        echo 'Job Complete'
    }
}