import groovy.json.JsonSlurperClassic

def removeBackupData(remote, filePath, keepCount) {
	// 원격 서버에서 오래된 백업 데이터를 제거하는 함수
  	// 기존 백업 파일 수 가져오기
  	def fileCountStr = sshCommand(remote: remote, command: "ls ${filePath} | wc -l")  // 파일 경로와 명령 결합
  	def fileCount = Integer.parseIn(fileCountStr)  // 문자열을 정수로 변환
   	// 유지해야 할 최대 파일 수보다 기존 파일 수가 많은지 확인
  	if (fileCount > keepCount) {
    	// 삭제할 파일 목록 가져오기 (수정 시간 기준 오래된 순으로 정렬)
    	def files = sshCommand(remote: remote, command: "ls ${filePath} -t -r")
		// 수정 시간 기준으로 파일 나열
    	// 파일 목록을 개별 파일 이름으로 분할
    	def fileList = files.split('\\r?\\n')
		// 개행문으로 분할
    	// 삭제할 파일 수만큼 반복 (최대 유지 수 초과 파일만 삭제)
    	for (int inx = 0; inx < (fileCount - keepCount); inx++) {
    		// 삭제할 파일 이름 출력 (정보 제공)
      		echo '삭제할 파일 이름: [${fileList[inx].trim()}]'
    		// 원격 서버의 'rm' 명령을 사용하여 특정 파일 삭제
      		sshCommand(remote: remote, command: "/usr/bin/rm -rf ${filePath}/${fileList[inx].trim()}")  // 전체 파일 경로 구성 및 삭제 실행
    	}
  	}
}

// 젠킨스 파이프라인 시작
node {
	/**
	 * Global Parameter
	 */
	// 현재 작업 디렉토리
    def workspace = pwd()
    // 현재 시간 변수
    def now = ''
    // 현재 날짜 변수
    def currentDate = ''
    // Jenkins Job 이름(dev-{기관 명}-{git repo. name})
    def jobName = env.JOB_NAME
    // 환경 이름 추출
    def envName = jobName.split('-')[0]
    // 기관 이름 추출
    def grpName = jobName.split('-')[1]
    // 프로젝트 이름 추출
    def pjtName = jobName.split('-')[2
    
	/**
	 * SSH Info.
	 */
    // 원격 서버 설정을 위한 맵
    def remote = [:]
    // SSH 포트 설정
    remote.port = 20022
    // 모든 호스트 허용 설정
    remote.allowAnyHosts = true
    
	/**
	 * Git Info.
	 */
    // Git URL 설정
    def gitIpParam = "${grpName.toUpperCase()}_GIP_IP"
    def appGitIp = env[gitIpParam]
    def appGitUrl = "http://${appGitIp}:40100"
    // Git Repository 경로(git 경로와 jobName을 맞추면 모두 변수 처리 가능)
    def appRepo = "/${grpName}/${pjtName}.git"
    // Git 브랜치 설정(git 경로와 jobName을 맞추면 모두 변수 처리 가능)
    def appGitBranch = "${envName}"
    
	/**
	 * M/W Info.
	 */
    // Number of WAS
    def wasCount = 1
    if(envName == "prd") {
    	wasCount = 2
    }
    // WAS Server Path
    def wasServerPath = "/app/lena/AppServer/servers/${grpName}App"
    // WAS Health Check Retry Count
    def wasCheckCount = 5
    // WAS Port(for Checking Health)
    def wasPort = 11100
    // WEB Deploy Path
    def webDeployPath = "/app/${pjtName}/front-end"
    // WEB Backup Path
    def webBackupPath = "/backup/${pjtName}/front-end"
	// WAS Deploy Path
	def wasDeployPath = "/dest/${pjtName}/back-end"
    // WAS Backup Path
    def wasBackupPath = "/backup/${pjtName}/back-end"
    
	/**
	 * Websquare Build Options
	 */
    // 0: minify
    // 1: 주석 공백 제거
    // 2: 주석, 고백제거, 로컬 변수 치환
    
    // JS 처리 값
    def jsValue = '0'
    // CSS 처리 값
    def cssValue = '1'
    // JS 생성 횟수
    def genJsCnt = 2
    
	/**
	 * Backup Info.
	 */
    // 백업 파일 보관 개수
    def filesToKeep = 3
    
	/**
	 * Jenkins Pipeline
	 */
    // Jenkins 시작 단계
    stage("Jenkins Start"){
    	sh "whoami"
    	// 현재 작업 디렉토리 출력
        echo workspace
        // 작업 디렉토리 정리
        cleanWs()
    }
    
    // GitLab 체크아웃 단계
    stage("Git Checkout"){
        try {
        	// 작업 디렉토리 정리
            step([$class: 'WsCleanup'])
            checkout([
                $class: 'GitSCM',
                // 체크아웃할 브랜치 설정
                branches: [[name: appGitBranch]],
                // 서브 모듈 설정 안함
                doGenerateSubmoduleConfigurations: false,
                // 클린 체크아웃
                extensions: [[$class: 'CleanCheckout']],
                submoduleCfg: [],
                userRemoteConfigs: [[
                	// GitLab 접근 자격 증명 ID
                    credentialsId: 'jenkins',
                    refspec: '+refs/heads/*:refs/remotes/origin/* +refs/merge-requests/*/head:refs/remotes/origin/merge-requests/*',
                    // GitLab URL 설정
                    url: appGitUrl + appRepo
                ]]
            ])
        } catch (err) {
        	// 에러 발생 시 설명 추가
            buildDescription "[Error Occurred(${env.STAGE_NAME} Failed) :: ${err.getMessage()}]"
            // 에러 발생 시 예외 던지기
            throw new Exception(err.getMessage())
        }
    }
    
	// JS 파일 생성 단계
	// 초기화 변수 src 설정
	def src = ''
	// genJsCnt 변수에 설정된 값만큼 반복 실행
	for (int inx = 1; inx <= genJsCnt; inx++) {
    	// inx가 1일 때 src를 'w2x'로 설정
    	if (inx == 1) {
        	src = 'w2x'
	    // 그 외의 경우 src를 'cm'으로 설정
	    } else {
	        src = 'cm'
	    }
        
        stage("JS-${inx} Generation") {
            try {
                dir(workspace) {
                	// wpack 옵션 설정
	        		// wpack 명령어 옵션 설정
                    def wpack_option = """
                    // 기본 디렉토리 설정
                    --baseDir "${workspace}/src/main/resources/static" 
                    // 소스 디렉토리 설정
                    --src "${workspace}/src/main/resources/static/${src}" 
                    // 결과 저장 디렉토리 설정
                    --dest "${workspace}/src/main/resources/static/_wpack_" 
                    // JS 압축 여부 설정
                    --js "${jsValue}"
                    // CSS 압축 여부 설정
                    --css "${cssValue}"
                    // 디버그 모드 비활성화 설정
                    --noDebug "false"
                    // Sourcemap 비활성화 설정
                    --noSourcemap "true"
                    """
                    
                    // 옵션 문자열에서 줄바꿈 제거
                    def replacedString = wpack_option.replaceAll('\n', ' ')
                    
                    // (wpack 버전이 최신일 경우 가능)w2x 빌드 시 추가 옵션: $p 생성
                    if (inx == 1) {
                    	replacedString += """ --config "${workspace}/src/main/resources/static/websquare/config.js" """
                    }
                    
                    // cm(js파일) 빌드 시 추가 옵션
                    if (inx == 2) {
                    	def rawFiles = sh(script: "find ${workspace}/src/main/resources/static/${src}/js -type f -name '*.js'", returnStdout: true).trim().split('\n')
                    	def jsFiles = []
                    	rawFiles.each() { file ->
                    		jsFiles.add(file.replace("${workspace}/src/main/resources/static", ""))
                    	}
                    	
                    	def dynamicCommonPath = jsFiles.join(',')
                    	
                    	replacedString += """ --common "true" --scopeCommon "com" --commonPath "${dynamicCommonPath}" """
                        replacedString += """ --ignore "${workspace}/src/main/resources/static/cm/template" """ 
                    }
                    
                    echo "Websqure Build Option :: ${replacedString}"
                    
                    // wpack 실행
                    sh "./standalone_wpack-linux ${replacedString}" 
                }
            } catch (err) {
                // 에러 발생 시 설명 추가
                buildDescription "[Error Occurred(${env.STAGE_NAME} Failed) :: ${err.getMessage()}]"
                // 에러 발생 시 예외 던지기
                throw new Exception(err.getMessage()) 
            }
        }
    }

    // Maven 빌드 단계
    stage('Maven Build') {
        try {
        	// tool 'MAVEN_HOME'의 의미는 jenkins management > tool에 등록된 maven_home 이름
        	// tool 'openjdk-17'의 의미는 jenkins management > tool에 등록된 java_home 이름이며, 서버의 java 버전과 빌드할 java 버전이 다를 경우 사용
            withEnv(['MAVEN_HOME=${tool 'MAVEN_HOME'}',
            		 "JAVA_HOME=${tool 'openjdk-17'}"
            ]) {
                sh '${MAVEN_HOME}/bin/mvn clean install -X -Dmaven.test.skip=true -U' // Maven 빌드 명령 실행
            }
        } catch (err) {
            // 에러 발생 시 설명 추가
            buildDescription "[Error Occurred(${env.STAGE_NAME} Failed) :: ${err.getMessage()}]"
            // 에러 발생 시 예외 던지기
            throw new Exception(err.getMessage()) 
        }
    }
    
	// WEB 서버 배포 및 백업 단계에 사용할 자격 증명 설정
	withCredentials([usernamePassword(credentialsId: 'lenaweb', passwordVariable: 'password', usernameVariable: 'userName')]) {
		// 원격 서버 이름 설정
	    remote.name = 'lenaweb'
	    // 원격 서버 사용자 이름 설정
	    remote.user = userName
	    // 원격 서버 비밀번호 설정
	    remote.password = password
		// 웹 배포 경로 설정
		// 배포할 정적 파일 이름 설정
	    def staticFile = "${pjtName}-static.tgz"
	    
	    // 웹 서버 IP 리스트를 순회하며 배포 진행
	    for (int inx = 1; inx <= webIpList.size(); inx++) {
	        // IP 주소가 비어있는지 확인하고 비어있으면 건너뜀
	        if (webIpList[inx - 1] == '' || webIpList[inx - 1].length() == 0) {
	            continue
	        }
	        
	        // 현재 순번의 웹 서버 IP 주소 설정
       		remote.host = webIpList[inx - 1]
            
            // WEB 서버 배포 단계
            stage("WEB-${inx} Deploy") {
                try {
                    // 배포 경로가 존재하는지 확인
                    def webDeployPathRes = sshCommand remote: remote, command: "test -d ${webDeployPath} && echo 1 || echo 2"
                    // 경로가 없으면 생성
                    if (webDeployPathRes == '2') {
                        sshCommand remote: remote, command: "mkdir -p ${webDeployPath}"
                    }
                    // 기존 파일 삭제
                    sshCommand remote: remote, command: "/usr/bin/rm -rf ${webDeployPath}/*"
                    // 정적 파일 업로드
                    sshPut remote: remote, from: "${workspace}/target/${staticFile}", into: "${webDeployPath}/"
                    // 정적 파일 압축 해제
                    sshCommand remote: remote, command: "/usr/bin/tar -xzvf ${webDeployPath}/${staticFile} -C ${webDeployPath}"
                } catch (err) {
                    // 에러 발생 시 설명 추가
                    buildDescription "[Error Occurred(${env.STAGE_NAME} Failed) :: ${err.getMessage()}]"
                    // 에러 발생 시 예외 던지기
                    throw new Exception(err.getMessage()) 
                }
            }
            
            // WEB 서버 백업 단계
            stage("WEB-${inx} Backup") {
                try {
                    // 현재 날짜 및 시간 가져오기
                    now = new Date()
                    currentDate = now.format('yyyy-MM-dd.HH:mm:ss', TimeZone.getTimeZone('Asia/Seoul'))
                    def backupFile = "${pjtName}-${currentDate}.war" 
                    // 백업 경로가 존재하는지 확인
                    def webBackupPathRes = sshCommand remote: remote, command: "test -d ${webBackupPath} && echo 1 || echo 2"
                    // 경로가 없으면 생성
                    if (webBackupPathRes == '2') {
                        sshCommand remote: remote, command: "mkdir -p ${webBackupPath}"
                    }
                    // 파일 복사하여 백업
                    sshCommand remote: remote, command: "/bin/cp ${webDeployPath}/${staticFile} ${webBackupPath}/${backupFile}"
                    // 백업 데이터 정리
                    removeBackupData(remote, webBackupPath, filesToKeep)
                } catch (err) {
                    // 에러 발생 시 설명 추가
                    buildDescription "[Error Occurred(${env.STAGE_NAME} Failed) :: ${err.getMessage()}]"
                    // 에러 발생 시 예외 던지기
                    throw new Exception(err.getMessage()) 
                }
                
                // 배포 경로에서 백업 파일 삭제
                sshCommand remote: remote, command: "/usr/bin/rm -rf ${webDeployPath}/${staticFile}"
            }
        }
    }
    
	// WAS 서버 배포 및 백업 단계에 사용할 자격 증명 설정
	withCredentials([usernamePassword(credentialsId: 'lena', passwordVariable: 'password', usernameVariable: 'userName')]) {
	    // 원격 서버 이름 설정
	    remote.name = 'lena'
	    // 원격 서버 사용자 이름 설정
	    remote.user = userName
	    // 원격 서버 비밀번호 설정
	    remote.password = password
	    // 배포할 빌드 파일 이름 설정
	    def buildFile = "${pjtName}.war"
	    
	    // WAS 서버 IP 리스트를 순회하며 배포 진행
	    def wasIp = ""
	    def wasIpParam = ""
	    for (int inx = 1; inx < (wasCount + 1)); inx++) {
	        // WAS IP 설정
	        // Jenkins System 변수에 "환경명_기관명_WAS_Index"가 설정되어져 있어야 함.(ex> DEV_KNP_WAS_1)
	        wasIpParam = "${env.Name.toUpperCase()}_${grpName.toUpperCase()}_WAS_${inx}"
	        wasIp = env[wasIpParam]
	        
	        // IP 주소가 비어있는지 확인하고 비어있으면 건너뜀
	        if (wasIp == "" || wasIp.length() == 0) {
	        	continue
	        }
	        
	        // 현재 순번의 WAS 서버 IP 주소 설정
        	remote.host = wasIp
        	
            // WAS 서버 중지 단계
            stage("WAS-${inx} Stop") {
                try {
                    if (envName == 'prd' || envName == 'edu') {
                        // 프로덕션 또는 교육 환경일 때
                        sshCommand remote: remote, command: "nohup ${wasServerPath}/stop0${inx}.sh > /dev/null 2>&1 &"
                    } else {
                        // 그 외 환경일 때
                        sshCommand remote: remote, command: "nohup ${wasServerPath}/stop.sh > /dev/null 2>&1 &"
                    }
                } catch (err) {
                    // 에러 발생 시 설명 추가
                    buildDescription "[Error Occurred(${env.STAGE_NAME} Failed) :: ${err.getMessage()}]"
                    // 에러 발생 시 예외 던지기
                    throw new Exception(err.getMessage()) 
                }
            }
            
            // WAS 서버 배포 단계
            stage("WAS-${inx} Deploy") {
                try {
                    def buildPath = "${workspace}/target"
                    dir(buildPath) {
                        // 배포 경로가 존재하는지 확인
                        def wasDeployPathRes = sshCommand remote: remote, command: "test -d ${wasDeployPath} && echo 1 || echo 2"
                        // 경로가 없으면 생성
                        if (wasDeployPathRes == '2') {
                            sshCommand remote: remote, command: "mkdir -p ${wasDeployPath}"
                        }
                        // 빌드 파일 목록 가져오기
                        def files = findFiles(glob: "**/*.war")
                        // 첫 번째 파일 선택
                        buildFile = files[0].name
                        // 기존 파일 삭제
                        sshCommand remote: remote, command: "/usr/bin/rm -rf ${wasDeployPath}/*"
                        // 빌드 파일 업로드
                        sshPut remote: remote, from: "${buildPath}/${buildFile}", into: "${wasDeployPath}"
                        // 빌드 파일 압축 해제
                        sshCommand remote: remote, command: "/usr/bin/unzip ${wasDeployPath}/${buildFile} -d ${wasDeployPath}" 
                    }
                } catch (err) {
                    // 에러 발생 시 설명 추가
                    buildDescription "[Error Occurred(${env.STAGE_NAME} Failed) :: ${err.getMessage()}]"
                    // 에러 발생 시 예외 던지기
                    throw new Exception(err.getMessage()) 
                }
            }
            
            // WAS 서버 시작 단계
            stage("WAS-${inx} Start") {
                try {
                    if (envName == 'prd' || envName == 'edu') {
                        // 프로덕션 또는 교육 환경일 때
                        sshCommand remote: remote, command: "nohup ${wasServerPath}/start0${inx}.sh > /dev/null 2>&1 &"
                    } else {
                        // 그 외 환경일 때
                        sshCommand remote: remote, command: "nohup ${wasServerPath}/start.sh > /dev/null 2>&1 &"
                    }
                } catch (err) {
                    // 에러 발생 시 설명 추가
                    buildDescription "[Error Occurred(${env.STAGE_NAME} Failed) :: ${err.getMessage()}]"
                    // 에러 발생 시 예외 던지기
                    throw new Exception(err.getMessage()) 
                }
            }
            
            // WAS 서버 백업 단계
            stage("WAS-${inx} Backup") {
                try {
                    // 현재 날짜 및 시간 가져오기
                    now = new Date()
                    currentDate = now.format('yyyy-MM-dd.HH:mm:ss', TimeZone.getTimeZone('Asia/Seoul'))
                    def backupFile = "${pjtName}-${currentDate}.war"
                    // 백업 경로가 존재하는지 확인
                    def wasBackupPathRes = sshCommand remote: remote, command: "test -d ${wasBackupPath} && echo 1 || echo 2"
                    // 경로가 없으면 생성
                    if (wasBackupPathRes == '2') {
                        sshCommand remote: remote, command: "mkdir -p ${wasBackupPath}"
                    }
                    // 파일 복사하여 백업
                    sshCommand remote: remote, command: "/bin/cp ${wasDeployPath}/${buildFile} ${wasBackupPath}/${backupFile}" 
                    // 백업 데이터 정리
                    removeBackupData(remote, wasBackupPath, filesToKeep)
                } catch (err) {
                    // 에러 발생 시 설명 추가
                    buildDescription "[Error Occurred(${env.STAGE_NAME} Failed) :: ${err.getMessage()}]"
                    // 에러 발생 시 예외 던지기
                    throw new Exception(err.getMessage()) 
                }
                
                // 배포 경로에서 백업 파일 삭제
                sshCommand remote: remote, command: "/usr/bin/rm -rf ${wasDeployPath}/${buildFile}" 
            }
            
            // WAS 서버 체크 단계
            stage("WAS-${inx} Check") {
                try {
                    def health = ""
                    def healthJson = ""
                    
                    for(int jnx=0; jnx<wasCheckCount; jnx++) {
                    	sleep 5
                    	try {
                    		healthJson = sshCommand(remote: remote, command: "curl http://localhost:${wasPort}/health")
                    	} catch (err) {
                    		echo "[Error Occurred(WAS Check SSH Connection Failed) :: ${err.getMessage()}]"
                    		continue
                    	}
                    	
                    	echo "health :: ${healthJson}"
                    	health = new JsonSlurperClassic().parseText(healthJson)
                    	
                    	if ("${health.status}" == 'UP') {
                    		break
                    	} else {
                    		continue
                    	}
                    }
                    
                    if ("${health.status}" != 'UP') {
                    	throw new Exception("Application Failed to Start!!!")
                    }
                } catch (err) {
                    // 에러 발생 시 설명 추가
                    buildDescription "[Error Occurred(${env.STAGE_NAME} Failed) :: ${err.getMessage()}]"
                    // 에러 발생 시 예외 던지기
                    throw new Exception(err.getMessage()) 
                }
            }
        }
    }
    
    // 젠킨스 빌드 파일 정리 단계
    stage('Cleanup') {
        // 작업 공간의 임시 파일 삭제
        dir("${env.WORKSPACE}@tmp") {
            // 임시 디렉토리 삭제
            deleteDir()
        }
    }
    
    // 완료 단계
