// 원격 서버에서 백업 데이터를 제거하는 함수 정의
def removeBackupData(remote, filePath, keepCount) {
	// 원격 서버에서 백업 파일 수를 계산
	def fileCountStr = sshCommand remote: remote, command: "ls ${filePath} | wc -l"
	// 파일 수를 정수로 변환
	def fileCount = Integer.parseInt(fileCountStr.trim())
	// 파일 수가 유지해야 할 파일 수보다 많으면 백업 제거 작업 수행
    if (fileCount > keepCount) {
        // 파일 리스트를 시간 순서대로 역순으로 가져옴
        def files = sshCommand remote: remote, command: "ls ${filePath} -t -r"
        // 파일 리스트를 줄바꿈으로 분할
        def fileList = files.split('\\r?\\n')
        // 오래된 파일을 삭제
        for (int inx = 0; inx < (fileCount - keepCount); inx++) {
        	// 삭제된 파일 이름 출력
            echo "removed file name: [${fileList[inx].trim()}]"
            // 파일 삭제
            sshCommand remote: remote, command: "/usr/bin/rm -rf ${filePath}/${fileList[inx].trim()}"
        }
    }
}

// Jenkins 파이프라인 시작
node {
	// 작업 공간 경로를 가져옴
    def workspace = pwd()
    
    // 원격 서버 설정 초기화
    def remote = [:]
    // 원격 서버 포트 설정
    remote.port = 20022
    // 모든 호스트 허용 설정
    remote.allowAnyHosts = true
    
    // 현재 시간을 저장할 변수 초기화
    def now = ''
    // 현재 날짜를 저장할 변수 초기화
    def currentDate = ''
    // Jenkins Job 이름 가져오기
    def jobName = env.JOB_NAME
    // 환경 이름 추출
    def envName = jobName.split('-')[0]
    // 프로젝트 이름 초기화
    def pjtName = ''
    
    // 프로젝트 이름 설정
	// Job 이름을 '-'로 분할하여 프로젝트 이름 추출
    if (jobName.split('-').size() == 2) {
    	// Job 이름이 두 부분으로 나누어질 경우, 두 번째 부분을 프로젝트 이름으로 설정
        pjtName = jobName.split('-')[1]
    } else {
        // Job 이름이 세 부분으로 나누어질 경우, 두 번째와 세 번째 부분을 합쳐서 프로젝트 이름으로 설정
        pjtName = jobName.split('-')[1] + '-' + jobName.split('-')[2]
    }
	
	// Git 저장소 URL, 리포지토리 경로 및 브랜치 설정
	// 애플리케이션 Git 저장소 URL
    def appGitUrl = 'http://192.168.56.1:40100'
    // 애플리케이션 리포지토리 경로(git 경로와 jobName을 맞추면 모두 변수 처리 가능)
    def appRepo = '/moj/mojda-batch.git'
    // 체크아웃할 Git 브랜치(git 경로와 jobName을 맞추면 모두 변수 처리 가능)
    def appGitBranch = 'develop'
    
    // WAS 서버 IP 리스트 설정
    def wasIpList = ['192.168.57.1', '192.168.57.2', '192.168.57.3', '192.168.57.4']
    // 실행 여부 리스트 설정
    def runYnList = ['Y', 'Y']
    // 유지할 파일 수 설정
    def filesToKeep = 3
    // 초기 메모리 설정
    def xms = '2048'
    // 최대 메모리 설정
    def xmx = '2048'
    // 메타영역 크기 설정
    def metaSize = '128'
    // 최대 메타영역 크기 설정
    def maxMetaSize = '512'
	// Java 라이브러리 경로 설정
    def javaLibPath = '/sw/ba_scp:/usr/java/packages/lib:/usr/lib64:/lib64:/lib:/usr/lib' 

	// Jenkins 시작 단계
    stage('Jenkins Start') {
    	 // 유효한 환경 이름인지 확인
		// 환경 이름이 'prd', 'dev', 'ver', 'edu' 중 하나가 아닌 경우
        if(envName != 'prd' && envName != 'dev' && envName != 'ver' && envName != 'edu') {
    		// 빌드 설명에 오류 메시지를 추가
    		buildDescription "[Error Occurred(Jenkins Start Failed) :: Invalid Env. Name(${envName})]"
    		// 예외를 발생시켜 빌드를 실패로 처리
    		throw new Exception ("Invalid Env. Name[${envName}]")
		}
		
		// 현재 작업 공간 디렉토리를 출력
		echo workspace
		// 작업 공간을 정리 (clean workspace)
		cleanWs()
	}
	
	// Gitlab에서 소스 체크아웃 단계
    stage('Git Checkout') {
   		try {
        	// 워크스페이스 정리
        	step([$class: 'WsCleanup'])
        	// Git 소스 체크아웃
        	checkout([
        		// Git 소스 코드 관리 클래스
            	$class: 'GitSCM',
            	// 체크아웃할 브랜치 이름
            	branches: [[name:appGitBranch]],
            	// 서브모듈 설정 생성을 비활성화
            	doGenerateSubmoduleConfigurations: false,
            	// 클린 체크아웃 수행
            	extension: [[$class: 'CleanCheckout']],
            	// 서브모듈 설정 (여기서는 비어 있음)
            	submoduleCfg: [],
            	userRemoteConfigs: [[
            		// Jenkins에 저장된 자격 증명 ID
                	credentialsId: 'jenkins',
                	// 참조 사양
                	refspec: '+refs/heads/*:refs/remotes/origin/* +refs/merge-requests/*/head:irefs/remotes/origin/merge-requests/*',
                	// Git 저장소 URL
                	url: appGitUrl + appRepo
            	]]
        	])
    	} catch (err) {
        	// 에러 발생 시 빌드 설명에 에러 메시지 추가
        	buildDescription "[Error Occurred(Git Checkout Failed) :: ${err.getMessage()}]"
        	// 예외를 발생시켜 빌드를 실패로 처리
        	throw new Exception(err.getMessage())
    	}
	}
	
    // Maven 빌드 단계
     stage('Maven Build') {
	    try {
	        // Maven 환경 설정 후 빌드 명령어 실행
	        withEnv(['MAVEN_HOME=${tool 'MAVEN_HOME'}']) {
	            // Maven을 사용하여 프로젝트를 클린하고 설치, 테스트는 스킵하고 업스트림 종속성을 최신으로 업데이트 (-U 옵션)
	            sh "${MAVEN_HOME}/bin/mvn clean install -X -Dmaven.test.skip=true -U"
	        }
	    } catch (err) {
	        // 빌드 실패 시 빌드 설명에 에러 메시지를 추가
	        buildDescription "[Error Occurred(Maven Build Failed) :: ${err.getMessage()}]"
	        // 예외를 발생시켜 빌드를 실패로 처리
	        throw new Exception(err.getMessage())
	    }
	}
	
    // 자격 증명 설정
     withCredentials([usernamePassword(credentialsId: 'jeus', passwordVariable: 'password', usernameVariable: 'userName')]) {
	    // 원격 서버 설정
	    // 원격 서버 이름
	    remote.name = 'jeus'
	    // 사용자 이름
	    remote.user = userName
	    // 사용자 비밀번호
	    remote.password = password
	    
	    // 배포 경로 설정
	    // WAS 배포 경로
	    def wasDeployPath = "/app/jeus/online/${mwInsName}"
	    // 빌드 파일 이름
	    def buildFile = "${pjtName}.war"
        // 각 WAS 서버에 대해 반복
		for (int inx = 1; inx <= wasIpList.size(); inx++) {
        	// IP가 빈 문자열이거나 길이가 0인 경우 건너뜀
        	if(wasIpList[inx-1] == '' || wasIpList[inx-1].length() == 0) {
            	continue
        	}
        	
        	// 원격 서버의 호스트를 설정
        	remote.host = wasIpList[inx-1]
        	
            // WAS 서버의 배치 애플리케이션 종료 단계
            stage("Batch-${inx} Stop") {
    			try {
        			// Java 프로세스의 PID를 찾기 위해 SSH 명령 실행
        			def pid = sshCommand remote: remote, command: "ps -ef | grep java | grep ${pjtName} | grep -v admin | grep -v adm | awk \'{print $2}\'"
        			// 찾은 PID 출력
        			echo "PID :: [${pid}]"
        
        			// PID가 null이거나 빈 문자열인 경우
        			if(pid == null || pid == '') {
            			// 해당 프로젝트가 실행 중이지 않음을 출력
            			echo "${pjtName} is not running!!!"
        			} else {
            			// Java 프로세스를 강제로 종료하기 위해 SSH 명령 실행
            			sshCommand remote: remote, command: "kill -9 ${pid}"
            
            			// 프로세스가 완전히 종료될 때까지 대기
            			while(pid != null && pid != '') {
                			// 대기 메시지 출력
                			echo '.'
                			// 1초간 대기
                			sleep(time: 1, unit: 'SECONDS')
                			// 종료된 프로세스의 PID 다시 확인
                			pid = sshCommand remote: remote, command: "ps -ef | grep java | grep ${pjtName} | grep -v admin | grep -v adm | awk \'{print $2}\'"
            			}
            			
	            		// 프로세스가 완전히 종료되었음을 알림
	            		echo "${pjtName} stopped!!!"
        			}
    			} catch (err) {
        			// 에러 발생 시 빌드 설명에 에러 메시지 추가
        			buildDescription "[Error Occurred(${env.STAGE_NAME} Failed) :: ${err.getMessage()}]"
        			// 예외 발생으로 빌드를 실패 처리
        			throw new Exception(err.getMessage())
    			}
			}
        
        	// WAS 서버의 배치 애플리케이션 백업 단계
			stage("Batch-${inx} Backup") {
    			try {
        			// 배포 경로에 파일 개수 확인을 위한 SSH 명령 실행
        			def fileCountStr = sshCommand remote: remote, command: "/bin/ls ${wasDeployPath}/${buildFile} | wc -l"
        			// 파일 개수를 정수로 변환
        			def fileCount = Integer.parseInt(fileCountStr)
        
        			// 파일 개수가 0보다 큰 경우 실행
        			if (fileCount > 0) {
			            // 현재 시간을 얻어옴
			            now = new Date()
			            currentDate = now.format('yyyy-MM-dd.HH:mm:ss', TimeZone.getTimeZone('Asia/Seoul'))
			            // 백업 파일 이름 생성
			            def backupFile = "${pjtName}-${currentDate}.war"
			            // WAS 백업 경로 정의
			            def wasBackupPath = "/data/jeus/backup/batch/${pjtName}"
			            
			            // 백업 경로가 존재하는지 확인하는 SSH 명령 실행
			            def wasBackupPathRes = sshCommand remote: remote, command: "test -d ${wasBackupPath} && echo 1 || echo 2"
			            
			            // 백업 경로가 없는 경우 생성
			            if (wasBackupPathRes == '2') {
			                sshCommand remote: remote, command: "mkdir -p ${wasBackupPath}"
			            }
			            
			            // 파일을 백업 경로로 복사하는 SSH 명령 실행
			            sshCommand remote: remote, command: "/bin/cp ${wasDeployPath}/${buildFile} ${wasBackupPath}/${backupFile}"
			            
			            // 백업 데이터 정리 함수 호출
			            removeBackupData(remote, wasBackupPath, filesToKeep)
			        }
			    } catch (err) {
			        // 에러 발생 시 빌드 설명에 에러 메시지 추가
			        buildDescription "[Error Occurred(${env.STAGE_NAME} Failed) :: ${err.getMessage()}]"
			        // 예외 발생으로 빌드를 실패 처리
			        throw new Exception(err.getMessage())
			    }
			}
			
            // 배치 애플리케이션 배포 단계
			stage("Batch-${inx} Deploy") {
    			try {
			        // 로컬 빌드 경로 설정
			        def buildPath = "${workspace}/target"
			        dir(buildPath) {
				        // 원격 서버에 배포할 경로 존재 여부 확인
				        def wasDeployPathRes = sshCommand remote: remote, command: "test -d ${wasDeployPath} && echo 1 || echo 2"
				        if (wasDeployPathRes == '2') {
				            sshCommand remote: remote, command: "mkdir -p ${wasDeployPath}"
				        }
				        // 빌드된 파일 중 첫 번째 *.jar 파일 선택
				        def files = findFiles(glob: "**/*.jar")
				        buildFile = files[0].name
				        
				        // 원격 서버의 기존 파일 모두 삭제
				        sshCommand remote: remote, command: "/usr/bin/rm -rf ${wasDeployPath}/*"
				        // 선택한 빌드 파일을 원격 서버로 전송
				        sshPut remote: remote, from: "${buildPath}/${buildFile}", into: "${wasDeployPath}"
			        }
			    } catch (err) {
			        // 에러 발생 시 빌드 설명에 에러 메시지 추가
			        buildDescription "[Error Occurred(${env.STAGE_NAME} Failed) :: ${err.getMessage()}]"
			        // 예외 발생으로 빌드를 실패 처리
			        throw new Exception(err.getMessage())
			    }
			}
			
			// 배치 애플리케이션 시작 단계
			if (runYnList[inx - 1] == 'Y') {
    			stage("Batch-${inx} Start") {
			        try {
			            // 로그 및 디렉토리 설정
						def logHome = "/logs/batch/${pjtName}"
						// 사용자 홈 디렉토리 설정
						def userHome = "/app/jeus/batch"
						// 애플리케이션 홈 디렉토리 설정
						def appHome = "${userHome}/${pjtName}"
						// 프로파일 초기화
						def profile = ""
	            
			            // 환경에 따라 프로파일 설정
			             if (envName == 'dev') {
				             // 개발 환경일 경우 'develop' 프로파일을 선택
				             profile = 'develop'
						} else {
				            // 개발 환경이 아닌 경우, 환경 이름(envName)을 프로파일로 설정
						   	profile = envName
						}
	            
	            		// JVM 옵션 설정
						def jvmOpts = """
						// 초기 힙 크기 설정. $xms 변수는 실행 시점에 할당된 메모리 값입니다.
						-Xms$xms
						// 최대 힙 크기 설정. $xmx 변수는 실행 시점에 할당된 메모리 값입니다.
						-Xmx$xmx
						// 메타스페이스 초기 크기 설정. $metaSize 변수는 실행 시점에 할당된 값입니다.
						-XX:MetaspaceSize=$metaSize  
						// 메타스페이스 최대 크기 설정. $maxMetaSize 변수는 실행 시점에 할당된 값입니다.
						-XX:MaxMetaspaceSize=$maxMetaSize  
						// 보안 특성을 강화하기 위한 랜덤 데이터 생성 시스템 속성 설정.
						-Djava.security.egd=file:/dev/./urandom
						// G1 GC(Garbage-First Garbage Collector) 활성화. 힙 관리의 효율성을 높이는 현대적인 GC 알고리즘입니다.
						-XX:+UseG1GC
						// GC 및 safe point 로그를 $logHome/gc/gc.log 파일에 시간 및 업타임 기준으로 기록합니다. 최대 3개 파일을 유지하며 각 파일 크기는 100MB로 제한합니다.
						-Xlog:gc*,safepoint:$logHome/gc/gc.log:time,uptime:filecount=3,filesize=100m
						// 메모리 부족 오류 발생 시 힙 덤프 생성 설정.
						-XX:+HeapDumpOnOutOfMemoryError
						// 힙 덤프 파일 생성 경로 설정. $logHome/dump/은 실행 시점에 할당된 값입니다.
						-XX:HeapDumpPath=$logHome/dump/
						// Spring 애플리케이션의 활성 프로파일 설정. $profile은 'develop', 'prd' 등의 값으로 설정됩니다.
						-Dspring.profiles.active=$profile
						// 프로젝트의 고유 식별자 설정. $pjtName은 실행 시점에 할당된 프로젝트 이름입니다.
						-Dkics.project-id=$pjtName
						// 사용자 홈 디렉토리 설정. $userHome은 실행 시점에 할당된 값입니다.
						-Duser.home=$userHome  
						// 로그 기본 경로 설정. $logHome은 실행 시점에 할당된 값입니다.
						-Dkics.logbase=$logHome  
						// Java 라이브러리 경로 설정. $javaLibPath는 실행 시점에 할당된 값입니다.
						-Djava.library.path=$javaLibPath  
						"""
						// JVM 옵션 문자열에서 개행 문자를 공백으로 대체하여 한 줄로 만듭니다.
	    				def replacedString = jvmOpts.replaceAll("\n", " ")
	    				// SSH를 사용하여 원격 서버에서 백그라운드로 Java 애플리케이션을 실행합니다.
	    				sshCommand remote: remote, command: "nohup java -jar ${replacedString} ${appHome}/${pjtName}.jar 1>${logHome}/application.log 2>&1 &"
					} catch (err) {
					    // 예외 발생 시 에러 메시지를 빌드 설명에 추가하고 예외를 다시 던집니다.
					    buildDescription "[Error Occurred(${env.STAGE_NAME} Failed) :: ${err.getMessage()}]"
					    throw new Exception(err.getMessage())
					}
				}
			}
		}
	}

	// 임시 작업 파일 정리 단계
	stage('Cleanup') {
    	dir("${env.WORKSPACE}@tmp") {
        	deleteDir()
    	}
	}
	
	// 작업 완료 메시지 출력 단계
	stage('Complete') {
	    echo 'Job Complete'
	}
}	