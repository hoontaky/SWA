import groovy.json.JsonSlurperClassic

def removeBackupData(remote, file_path, keep_count) {
	// 원격 서버에서 오래된 백업 데이터를 제거하는 함수
  	// 기존 백업 파일 수 가져오기
  	def file_count_str = sshCommand(remote: remote, command: "ls ${file_path} | wc -l")  // 파일 경로와 명령 결합
  	def file_count = Integer.parseIn(file_count_str)  // 문자열을 정수로 변환
   	// 유지해야 할 최대 파일 수보다 기존 파일 수가 많은지 확인
  	if (file_count > keep_count) {
    	// 삭제할 파일 목록 가져오기 (수정 시간 기준 오래된 순으로 정렬)
    	def files = sshCommand(remote: remote, command: "ls ${file_path} -t -r")
		// 수정 시간 기준으로 파일 나열
    	// 파일 목록을 개별 파일 이름으로 분할
    	def file_list = files.split('\\r?\\n')
		// 개행문으로 분할
    	// 삭제할 파일 수만큼 반복 (최대 유지 수 초과 파일만 삭제)
    	for (int inx = 0; inx < (file_count - keep_count); inx++) {
    		// 삭제할 파일 이름 출력 (정보 제공)
      		echo '삭제할 파일 이름: [${file_list[inx].trim()}]'
    		// 원격 서버의 'rm' 명령을 사용하여 특정 파일 삭제
      		sshCommand(remote: remote, command: "/usr/bin/rm -rf ${file_path}/${file_list[inx].trim()}")  // 전체 파일 경로 구성 및 삭제 실행
    	}
  	}
}

// 젠킨스 파이프라인 시작
node {
	// 현재 작업 디렉토리
    def workspace = pwd()
    
    // 원격 서버 설정을 위한 맵
    def remote = [:]
    // SSH 포트 설정
    remote.port = 20022
    // 모든 호스트 허용 설정
    remote.allowAnyHosts = true
    
    // 현재 시간 변수
    def now = ''
    // 현재 날짜 변수
    def currentDate = ''
    // Jenkins Job 이름(dev-{기관 명}-{git repo. name})
    def jobName = env.JOB_NAME
    // 환경 이름 추출
    def envName = jobName.split('-')[0]
    // 기관 이름 추출
    def grpName = jobName.split('-')[1]
    // 프로젝트 이름 추출
    def pjtName = jobName.split('-')[2]
    
    // GitLab URL 설정
    def gitIpParam = "${grpName.toUpperCase()}_GIP_IP"
    def appGitIp = env[gitIpParam]
    def appGitUrl = "http://${appGitIp}:40100"
    // GitLab Repository 경로(git 경로와 jobName을 맞추면 모두 변수 처리 가능)
    def appRepo = "/${grpName}/${pjtName}.git"
    // GitLab 브랜치 설정(git 경로와 jobName을 맞추면 모두 변수 처리 가능)
    def appGitBranch = "${envName}"
    
    // WEB 서버 IP 리스트
    def webIpList = ['192.168.56.1', '192.168.56.2']
    // WAS 서버 IP 리스트
    def wasIpList = ['192.168.57.1', '192.168.57.2', '192.168.57.3', '192.168.57.4']
    // WAS Server Path
    def wasServerPath = "/app/lena/AppServer/servers/${grpName}Bat"
    // WAS Health Check Retry Count
    def wasCheckCount = 5
    
    // 백업 파일 보관 개수
    def filesToKeep = 3
    
    // Jenkins 시작 단계
    stage("Jenkins Start"){
    	sh "whoami"
    	// 현재 작업 디렉토리 출력
        echo workspace
        // 작업 디렉토리 정리
        cleanWs()
    }
    
    // GitLab 체크아웃 단계
    stage("Git Checkout"){
        try {
        	// 작업 디렉토리 정리
            step([$class: 'WsCleanup'])
            checkout([
                $class: 'GitSCM',
                // 체크아웃할 브랜치 설정
                branches: [[name: appGitBranch]],
                // 서브 모듈 설정 안함
                doGenerateSubmoduleConfigurations: false,
                // 클린 체크아웃
                extensions: [[$class: 'CleanCheckout']],
                submoduleCfg: [],
                userRemoteConfigs: [[
                	// GitLab 접근 자격 증명 ID
                    credentialsId: 'jenkins',
                    refspec: '+refs/heads/*:refs/remotes/origin/* +refs/merge-requests/*/head:refs/remotes/origin/merge-requests/*',
                    // GitLab URL 설정
                    url: appGitUrl + appRepo
                ]]
            ])
        } catch (err) {
        	// 에러 발생 시 설명 추가
            buildDescription "[Error Occurred(Git Checkout Failed) :: ${err.getMessage()}]"
            // 에러 발생 시 예외 던지기
            throw new Exception(err.getMessage())
        }
    }

    // Maven 빌드 단계
    stage('Maven Build') {
        try {
        	// tool 'MAVEN_HOME'의 의미는 jenkins management > tool에 등록된 maven_home 이름
        	// tool 'openjdk-17'의 의미는 jenkins management > tool에 등록된 java_home 이름이며, 서버의 java 버전과 빌드할 java 버전이 다를 경우 사용
            withEnv(['MAVEN_HOME=${tool 'MAVEN_HOME'}',
            		 "JAVA_HOME=${tool 'openjdk-17'}"
            ]) {
                sh '${MAVEN_HOME}/bin/mvn clean install -X -Dmaven.test.skip=true -U' // Maven 빌드 명령 실행
            }
        } catch (err) {
            // 에러 발생 시 설명 추가
            buildDescription "[Error Occurred(Maven Build Failed) :: ${err.getMessage()}]"
            // 에러 발생 시 예외 던지기
            throw new Exception(err.getMessage()) 
        }
    }
    
	// WAS 서버 배포 및 백업 단계에 사용할 자격 증명 설정
	withCredentials([usernamePassword(credentialsId: 'lena', passwordVariable: 'password', usernameVariable: 'userName')]) {
	    // 원격 서버 이름 설정
	    remote.name = 'lena'
	    // 원격 서버 사용자 이름 설정
	    remote.user = userName
	    // 원격 서버 비밀번호 설정
	    remote.password = password
	    
	    // WAS 배포 경로 설정
	    def was_deploy_path = "/dest/${pjtName}/back-end"
	    // 배포할 빌드 파일 이름 설정
	    def build_file = "${pjtName}.war"
	    // WAS 서버 IP 리스트를 순회하며 배포 진행
	    for (int inx = 1; inx <= wasIpList.size(); inx++) {
	        // IP 주소가 비어있는지 확인하고 비어있으면 건너뜀
	        if (wasIpList[inx - 1] == '' || wasIpList[inx - 1].length() == 0) {
	            continue
	        }
	        
	        // 현재 순번의 WAS 서버 IP 주소 설정
        	remote.host = wasIpList[inx - 1]
        	
            // WAS 서버 중지 단계
            stage("WAS-${inx} Stop") {
                try {
                    if (envName == 'prd' || envName == 'edu') {
                        // 프로덕션 또는 교육 환경일 때
                        sshCommand remote: remote, command: "nohup ${wasServerPath}/stop0${inx}.sh > /dev/null 2>&1 &"
                    } else {
                        // 그 외 환경일 때
                        sshCommand remote: remote, command: "nohup ${wasServerPath}/stop.sh > /dev/null 2>&1 &"
                    }
                } catch (err) {
                    // 에러 발생 시 설명 추가
                    buildDescription "[Error Occurred(WAS-${inx} Stop Failed) :: ${err.getMessage()}]"
                    // 에러 발생 시 예외 던지기
                    throw new Exception(err.getMessage()) 
                }
            }
            
            // WAS 서버 배포 단계
            stage("WAS-${inx} Deploy") {
                try {
                    def build_path = "${workspace}/target"
                    dir(build_path) {
                        // 배포 경로가 존재하는지 확인
                        def wasDeployPathRes = sshCommand remote: remote, command: "test -d ${was_deploy_path} && echo 1 || echo 2"
                        // 경로가 없으면 생성
                        if (wasDeployPathRes == '2') {
                            sshCommand remote: remote, command: "mkdir -p ${was_deploy_path}"
                        }
                        // 빌드 파일 목록 가져오기
                        def files = findFiles(glob: "**/*.war")
                        // 첫 번째 파일 선택
                        build_file = files[0].name
                        // 기존 파일 삭제
                        sshCommand remote: remote, command: "/usr/bin/rm -rf ${was_deploy_path}/*"
                        // 빌드 파일 업로드
                        sshPut remote: remote, from: "${build_path}/${build_file}", into: "${was_deploy_path}"
                        // 빌드 파일 압축 해제
                        sshCommand remote: remote, command: "/usr/bin/unzip ${was_deploy_path}/${build_file} -d ${was_deploy_path}" 
                    }
                } catch (err) {
                    // 에러 발생 시 설명 추가
                    buildDescription "[Error Occurred(WAS-${inx} Deploy Failed) :: ${err.getMessage()}]"
                    // 에러 발생 시 예외 던지기
                    throw new Exception(err.getMessage()) 
                }
            }
            
            // WAS 서버 시작 단계
            stage("WAS-${inx} Start") {
                try {
                    if (envName == 'prd' || envName == 'edu') {
                        // 프로덕션 또는 교육 환경일 때
                        sshCommand remote: remote, command: "nohup ${wasServerPath}/start0${inx}.sh > /dev/null 2>&1 &"
                    } else {
                        // 그 외 환경일 때
                        sshCommand remote: remote, command: "nohup ${wasServerPath}/start.sh > /dev/null 2>&1 &"
                    }
                } catch (err) {
                    // 에러 발생 시 설명 추가
                    buildDescription "[Error Occurred(WAS-${inx} Start Failed) :: ${err.getMessage()}]"
                    // 에러 발생 시 예외 던지기
                    throw new Exception(err.getMessage()) 
                }
            }
            
            // WAS 서버 백업 단계
            stage("WAS-${inx} Backup") {
                try {
                    // 현재 날짜 및 시간 가져오기
                    now = new Date()
                    currentDate = now.format('yyyy-MM-dd.HH:mm:ss', TimeZone.getTimeZone('Asia/Seoul'))
                    def backFile = "${currentDate}-${build_file}"
                    // 백업 경로 설정
                    def v_was_backup_path = "/backup/${pjtName}/back-end"
                    // 백업 경로가 존재하는지 확인
                    def wasBackupPathRes = sshCommand remote: remote, command: "test -d ${v_was_backup_path} && echo 1 || echo 2"
                    // 경로가 없으면 생성
                    if (wasBackupPathRes == '2') {
                        sshCommand remote: remote, command: "mkdir -p ${v_was_backup_path}"
                    }
                    // 파일 복사하여 백업
                    sshCommand remote: remote, command: "/bin/cp ${was_deploy_path}/${build_file} ${v_was_backup_path}/${backFile}" 
                    // 백업 데이터 정리
                    removeBackupData(remote, v_was_backup_path, filesToKeep)
                } catch (err) {
                    // 에러 발생 시 설명 추가
                    buildDescription "[Error Occurred(WAS-${inx} Backup Failed) :: ${err.getMessage()}]"
                    // 에러 발생 시 예외 던지기
                    throw new Exception(err.getMessage()) 
                }
                
                // 배포 경로에서 백업 파일 삭제
                sshCommand remote: remote, command: "/usr/bin/rm -rf ${was_deploy_path}/${build_file}" 
            }
            
            // WAS 서버 체크 단계
            stage("WAS-${inx} Check") {
                try {
                    def health = ""
                    def healthJson = ""
                    
                    for(int jnx=0; jnx<wasCheckCount; jnx++) {
                    	sleep 5
                    	try {
                    		healthJson = sshCommand(remote: remote, command: "curl http://localhost:11100/health")
                    	} catch (err) {
                    		echo "[Error Occurred(WAS Check SSH Connection Failed) :: ${err.getMessage()}]"
                    		continue
                    	}
                    	
                    	echo "health :: ${healthJson}"
                    	health = new JsonSlurperClassic().parseText(healthJson)
                    	
                    	if ("${health.status}" == 'UP') {
                    		break
                    	} else {
                    		continue
                    	}
                    }
                    
                    if ("${health.status}" != 'UP') {
                    	throw new Exception("Application Failed to Start!!!")
                    }
                } catch (err) {
                    // 에러 발생 시 설명 추가
                    buildDescription "[Error Occurred(WAS Check Failed) :: ${err.getMessage()}]"
                    // 에러 발생 시 예외 던지기
                    throw new Exception(err.getMessage()) 
                }
            }
        }
    }
    
    // 젠킨스 빌드 파일 정리 단계
    stage('Cleanup') {
        // 작업 공간의 임시 파일 삭제
        dir("${env.WORKSPACE}@tmp") {
            // 임시 디렉토리 삭제
            deleteDir()
        }
    }
    
    // 완료 단계
    stage('Complete') {
        // 작업 완료 메시지 출력
        echo 'Job Complete'
    }
}