# 빌드 결과 조회 API 호출

curl -u "<jenkins_user>:<token>" "http://<jenkins_url>/job/<project_name>/lastBuild/api/json?tree=number,result,url,timestamp

사용자 별, token 발급은 Jenkins 프로필 클릭 > Security > "Add new token" 

=====================================================Sample=====================================================

#!/bin/bash
#Group List
grps=("cio" "moj")

#Project List
pjts=("ewpApp" "ewpBat")

i=0
iLen=${#grps[@]}

while [ $i -lt $iLen ]; do
	grp=${grps[$i]}
	
	j=0
	jLen=${#pjts[@]}
	
	while [ $j -lt $jLen ]; do
		
		# Version 1
		curl -u "admin:XXXXXXXXXXXXXXXXXX" "http://localhost:8085/job/dev-$grp-$pjt/lastBuild/api/json?tree=number,result,url,timestamp"
		# Version 2
		curl -u "admin:XXXXXXXXXXXXXXXXXX" "http://localhost:8085/job/dev-$grp-$pjt/lastBuild/api/json?tree=number,result,url,timestamp" 
		| awk '{match($0, /"timestamp":[0-9]+/); ts=substr($0, RSTART+12, 10); dt=strftime("%Y-%m-%d %H:%M:%S", ts); sub(/"timestamp":[0-9]+/, "\"timestamp\":\"" dt "\"", $0); print }'
		| sed 's/"_class":"org.jenkinsci.plugins.workflow.job.WorkflowRun", \s*//g'
		echo ""
	
		((j++))
	
	done
	
	((i++))
	
done

exit 1
	