def removeBackupData(remote, file_path, keep_count) {
	// 원격 서버에서 오래된 백업 데이터를 제거하는 함수
  	// 기존 백업 파일 수 가져오기
  	def file_count_str = sshCommand(remote: remote, command: 'ls ' + file_path + ' | wc -l')  // 파일 경로와 명령 결합
  	def file_count = Integer.parseIn(file_count_str)  // 문자열을 정수로 변환
   	// 유지해야 할 최대 파일 수보다 기존 파일 수가 많은지 확인
  	if (file_count > keep_count) {
    	// 삭제할 파일 목록 가져오기 (수정 시간 기준 오래된 순으로 정렬)
    	def files = sshCommand(remote: remote, command: 'ls ' + file_path + ' -t -r')
		// 수정 시간 기준으로 파일 나열
    	// 파일 목록을 개별 파일 이름으로 분할
    	def file_list = files.split('\\r?\\n')
		// 개행문으로 분할
    	// 삭제할 파일 수만큼 반복 (최대 유지 수 초과 파일만 삭제)
    	for (int inx = 0; inx < (file_count - keep_count); inx++) {
    		// 삭제할 파일 이름 출력 (정보 제공)
      		echo '삭제할 파일 이름: [${file_list[inx].trim()}]'
    		// 원격 서버의 'rm' 명령을 사용하여 특정 파일 삭제
      		sshCommand(remote: remote, command: '/usr/bin/rm -rf ' + file_path + '/' + file_list[inx].trim())  // 전체 파일 경로 구성 및 삭제 실행
    	}
  	}
}

// 젠킨스 파이프라인 시작
node {
    def workspace = pwd() // 현재 작업 디렉토리
    def remote = [:] // 원격 서버 설정을 위한 맵
    remote.port = 20022 // SSH 포트 설정
    remote.allowAnyHosts = true // 모든 호스트 허용 설정
    def now = '' // 현재 시간 변수
    def currentDate = '' // 현재 날짜 변수
    def jobName = env.JOB_NAME // Jenkins Job 이름
    def envName = jobName.split('-')[0] // 환경 이름 추출
    def pjtName = jobName.split('-')[1] // 프로젝트 이름 추출
    def appGitUrl = 'http://192.168.56.1:40100' // GitLab URL 설정
    def appRepo = '/moj/mojda.git' // GitLab Repository 경로
    def appGitBranch = 'develop' // GitLab 브랜치 설정
    def webIpList = ['192.168.56.1', '192.168.56.2'] // WEB 서버 IP 리스트
    def wasIpList = ['192.168.57.1', '192.168.57.2', '192.168.57.3', '192.168.57.4'] // WAS 서버 IP 리스트
    def ozIpList = ['192.168.58.1', '192.168.58.2'] // 보고서 서버 IP 리스트
    def mwInsName = 'momspda' // Middleware Instance 이름
    def domainName = 'iop' // 도메인 이름
    def jsValue = '0' // JS 처리 값
    def cssValue = '1' // CSS 처리 값
    def genJsCnt = 2 // JS 생성 횟수
    def filesToKeep = 3 // 백업 파일 보관 개수
    
    // Jenkins 시작 단계
    stage('Jenkins Start'){
        echo workspace // 현재 작업 디렉토리 출력
        cleanWs() // 작업 디렉토리 정리
    }
    
    // GitLab 체크아웃 단계
    stage('Gitlab Checkout'){
        try {
            step([$class: 'WsCleanup']) // 작업 디렉토리 정리
            checkout([
                $class: 'GitSCM',
                branches: [[name: appGitBranch]], // 체크아웃할 브랜치 설정
                doGenerateSubmoduleConfigurations: false, // 서브 모듈 설정 안함
                extensions: [[$class: 'CleanCheckout']], // 클린 체크아웃
                submoduleCfg: [],
                userRemoteConfigs: [[
                    credentialsId: 'jenkins', // GitLab 접근 자격 증명 ID
                    refspec: '+refs/heads/*:refs/remotes/origin/* +refs/merge-requests/*/head:refs/remotes/origin/merge-requests/*',
                    url: appGitUrl + appRepo // GitLab URL 설정
                ]]
            ])
        } catch (err) {
            buildDescription '[Error Occurred(Git Checkout Failed) :: ' + err.getMessage() + ']' // 에러 발생 시 설명 추가
            throw new Exception(err.getMessage()) // 에러 발생 시 예외 던지기
        }
    }
    
	// JS 파일 생성 단계
	// 초기화 변수 src 설정
	def src = ''
	// genJsCnt 변수에 설정된 값만큼 반복 실행
	for (int inx = 1; inx <= genJsCnt; inx++) {
    	// inx가 1일 때 src를 'w2x'로 설정
    	if (inx == 1) {
        	src = 'w2x'
	    // 그 외의 경우 src를 'cm'으로 설정
	    } else {
	        src = 'cm'
	    }
        
        stage('JS-' + inx + ' Generation') {
            try {
                dir(workspace) {
                	// wpack 옵션 설정
	        		// wpack 명령어 옵션 설정
                    def wpack_option = '''
                    --baseDir '$workspace/src/main/resources/static' 
                    // 기본 디렉토리 설정
                    --src '$workspace/src/main/resources/static/$src' 
                    // 소스 디렉토리 설정
                    --dest '$workspace/src/main/resources/static/_wpack_' 
                    // 결과 저장 디렉토리 설정
                    --js '$jsValue' // JS 압축 여부 설정
                    --css '$cssValue' // CSS 압축 여부 설정
                    --noDebug 'false' // 디버그 모드 비활성화 설정
                    --noSourcemap 'true' // Sourcemap 비활성화 설정
                    '''                    
                    def replacedString = wpack_option.replaceAll('\n', ' ') // 옵션 문자열에서 줄바꿈 제거
                    // 2번째 JS 생성 시 추가 옵션
                    if (inx == 2) {
                        replacedString += ''' --ignore '$workspace/src/main/resources/static/cm/template' ''' 
                    }
                    // wpack 실행
                    dir('/data') {
                        sh './standalone_wpack-linux ' + replacedString 
                    }
                }
            } catch (err) {
                // 에러 발생 시 예외 던지기
                buildDescription '[Error Occurred(Javascript Generate from xml Failed) :: ' + err.getMessage() + ']' // 에러 발생 시 설명 추가
                throw new Exception(err.getMessage()) 
            }
        }
    }

    // Maven 빌드 단계
    stage('Maven Build') {
        try {
            withEnv(['MAVEN_HOME=${tool 'MAVEN_HOME'}']) {
                sh '${MAVEN_HOME}/bin/mvn clean install -X -Dmaven.test.skip=true -U' // Maven 빌드 명령 실행
            }
        } catch (err) {
            // 에러 발생 시 예외 던지기
            buildDescription '[Error Occurred(Maven Build Failed) :: ' + err.getMessage() + ']' // 에러 발생 시 설명 추가
            throw new Exception(err.getMessage()) 
        }
    }
    
	// WEB 서버 배포 및 백업 단계에 사용할 자격 증명 설정
	withCredentials([usernamePassword(credentialsId: 'webtob', passwordVariable: 'password', usernameVariable: 'userName')]) {
	    remote.name = 'webtob' // 원격 서버 이름 설정
	    remote.user = userName // 원격 서버 사용자 이름 설정
	    remote.password = password // 원격 서버 비밀번호 설정
	    def web_deploy_path = '/app/webtob/online/' + domainName + '/' + mwInsName 
		// 웹 배포 경로 설정
	    def static_file = pjtName + '-static.tgz' // 배포할 정적 파일 이름 설정
	    // 웹 서버 IP 리스트를 순회하며 배포 진행
	    for (int inx = 1; inx <= webIpList.size(); inx++) {
	        // IP 주소가 비어있는지 확인하고 비어있으면 건너뜀
	        if (webIpList[inx - 1] == '' || webIpList[inx - 1].length() == 0) {
	            continue
	        }
       		remote.host = webIpList[inx - 1] // 현재 순번의 웹 서버 IP 주소 설정
            
            // WEB 서버 배포 단계
            stage('WEB-' + inx + ' Deploy') {
                try {
                    // 배포 경로가 존재하는지 확인
                    def webDeployPathRes = sshCommand remote: remote, command: 'test -d ' + web_deploy_path + ' && echo 1 || echo 2'
                    if (webDeployPathRes == '2') {
                        // 경로가 없으면 생성
                        sshCommand remote: remote, command: 'mkdir -p ' + web_deploy_path
                    }
                    // 기존 파일 삭제
                    sshCommand remote: remote, command: '/usr/bin/rm -rf ' + web_deploy_path + '/*'
                    // 정적 파일 업로드
                    sshPut remote: remote, from: workspace + '/target/' + static_file, into: web_deploy_path + '/'
                    // 정적 파일 압축 해제
                    sshCommand remote: remote, command: '/usr/bin/tar -xf ' + web_deploy_path + '/' + static_file + ' -C ' + web_deploy_path
                    // WAS 관리자 명령어 실행
                    sshCommand remote: remote, command: 'source ~/.bash_profile; wasadmin -C \'cr -a\''
                } catch (err) {
                    // 에러 발생 시 예외 던지기
                    buildDescription '[Error Occurred(WEB Server Deploy Failed) :: ' + err.getMessage() + ']' // 에러 발생 시 설명 추가
                    throw new Exception(err.getMessage()) 
                }
            }
            
            // WEB 서버 백업 단계
            stage('WEB-' + inx + ' Backup') {
                try {
                    // 현재 날짜 및 시간 가져오기
                    now = new Date()
                    currentDate = now.format('yyyy-MM-dd.HH:mm:ss', TimeZone.getTimeZone('Asia/Seoul'))
                    def backFile = currentDate + '-' + static_file
                    // 백업 경로 설정
                    def v_web_backup_path = '/data/webtob/backup/' + domainName + '/' + mwInsName
                    // 백업 경로가 존재하는지 확인
                    def webBackupPathRes = sshCommand remote: remote, command: 'test -d ' + v_web_backup_path + ' && echo 1 || echo 2'
                    if (webBackupPathRes == '2') {
                        // 경로가 없으면 생성
                        sshCommand remote: remote, command: 'mkdir -p ' + v_web_backup_path
                    }
                    // 파일 복사하여 백업
                    sshCommand remote: remote, command: '/bin/cp ' + web_deploy_path + '/' + static_file + ' ' + v_web_backup_path + '/' + backFile
                    // 백업 데이터 정리
                    removeBackupData(remote, v_web_backup_path, filesToKeep)
                } catch (err) {
                    // 에러 발생 시 예외 던지기
                    buildDescription '[Error Occurred(WEB Server Backup Failed) :: ' + err.getMessage() + ']' // 에러 발생 시 설명 추가
                    throw new Exception(err.getMessage()) 
                }
                
                // 배포 경로에서 백업 파일 삭제
                sshCommand remote: remote, command: '/usr/bin/rm -rf ' + web_deploy_path + '/' + static_file
            }
        }
    }
    
	// WAS 서버 배포 및 백업 단계에 사용할 자격 증명 설정
	withCredentials([usernamePassword(credentialsId: 'jeus', passwordVariable: 'password', usernameVariable: 'userName')]) {
	    remote.name = 'jeus' // 원격 서버 이름 설정
	    remote.user = userName // 원격 서버 사용자 이름 설정
	    remote.password = password // 원격 서버 비밀번호 설정
	    def was_deploy_path = '/app/jeus/online/' + mwInsName // WAS 배포 경로 설정
	    def build_file = pjtName + '.war' // 배포할 빌드 파일 이름 설정
	    // WAS 서버 IP 리스트를 순회하며 배포 진행
	    for (int inx = 1; inx <= wasIpList.size(); inx++) {
	        // IP 주소가 비어있는지 확인하고 비어있으면 건너뜀
	        if (wasIpList[inx - 1] == '' || wasIpList[inx - 1].length() == 0) {
	            continue
	        }
	        
        	remote.host = wasIpList[inx - 1] // 현재 순번의 WAS 서버 IP 주소 설정
        	
            // WAS 서버 중지 단계
            stage('WAS-' + inx + ' Stop') {
                try {
                    if (envName == 'prd' || envName == 'edu') {
                        // 프로덕션 또는 교육 환경일 때
                        sshCommand remote: remote, command: 'source ~/.bash_profile; /sw/jeus/bin/msdown_' + mwInsName + '0' + inx + ' || true'
                    } else {
                        // 그 외 환경일 때
                        sshCommand remote: remote, command: 'source ~/.bash_profile; /sw/jeus/bin/msdown_' + mwInsName + ' || true'
                    }
                } catch (err) {
                    // 에러 발생 시 예외 던지기
                    buildDescription '[Error Occurred(WAS Server Stop Failed) :: ' + err.getMessage() + ']' // 에러 발생 시 설명 추가
                    throw new Exception(err.getMessage()) 
                }
            }
            
            // WAS 서버 배포 단계
            stage('WAS-' + inx + ' Deploy') {
                try {
                    def build_path = workspace + '/target'
                    dir(build_path) {
                        // 배포 경로가 존재하는지 확인
                        def wasDeployPathRes = sshCommand remote: remote, command: 'test -d ' + was_deploy_path + ' && echo 1 || echo 2'
                        if (wasDeployPathRes == '2') {
                            // 경로가 없으면 생성
                            sshCommand remote: remote, command: 'mkdir -p ' + was_deploy_path
                        }
                        // 빌드 파일 목록 가져오기
                        def files = findFiles(glob: ‘**/*.war’)
                        build_file = files[0].name // 첫 번째 파일 선택
                        // 기존 파일 삭제
                        sshCommand remote: remote, command: '/usr/bin/rm -rf ' + was_deploy_path + '/*'
                        // 빌드 파일 업로드
                        sshPut remote: remote, from: build_path + '/' + build_file, into: was_deploy_path
                        // 빌드 파일 압축 해제
                        sshCommand remote: remote, command: '/usr/bin/unzip ' + was_deploy_path + '/' + build_file + ' -d ' + was_deploy_path
                    }
                } catch (err) {
                    // 에러 발생 시 예외 던지기
                    buildDescription '[Error Occurred(WAS Server Deploy Failed) :: ' + err.getMessage() + ']' // 에러 발생 시 설명 추가
                    throw new Exception(err.getMessage()) 
                }
            }
            
            // WAS 서버 시작 단계
            stage('WAS-' + inx + ' Start') {
                try {
                    if (envName == 'prd' || envName == 'edu') {
                        // 프로덕션 또는 교육 환경일 때
                        sshCommand remote: remote, command: 'source ~/.bash_profile; /sw/jeus/bin/msboot_' + mwInsName + '0' + inx + ' || true'
                    } else {
                        // 그 외 환경일 때
                        sshCommand remote: remote, command: 'source ~/.bash_profile; /sw/jeus/bin/msboot_' + mwInsName + ' || true'
                    }
                } catch (err) {
                    // 에러 발생 시 예외 던지기
                    buildDescription '[Error Occurred(WAS Server Start Failed) :: ' + err.getMessage() + ']' // 에러 발생 시 설명 추가
                    throw new Exception(err.getMessage()) 
                }
            }
            
            // WAS 서버 백업 단계
            stage('WAS-' + inx + ' Backup') {
                try {
                    // 현재 날짜 및 시간 가져오기
                    now = new Date()
                    currentDate = now.format('yyyy-MM-dd.HH:mm:ss', TimeZone.getTimeZone('Asia/Seoul'))
                    def backFile = currentDate + '-' + build_file
                    // 백업 경로 설정
                    def v_was_backup_path = '/data/jeus/backup/online/' + mwInsName
                    // 백업 경로가 존재하는지 확인
                    def wasBackupPathRes = sshCommand remote: remote, command: 'test -d ' + v_was_backup_path + ' && echo 1 || echo 2'
                    if (wasBackupPathRes == '2') {
                        // 경로가 없으면 생성
                        sshCommand remote: remote, command: 'mkdir -p ' + v_was_backup_path
                    }
                    // 파일 복사하여 백업
                    sshCommand remote: remote, command: '/bin/cp ' + was_deploy_path + '/' + build_file + ' ' + v_was_backup_path + '/' + backFile
                    // 백업 데이터 정리
                    removeBackupData(remote, v_was_backup_path, filesToKeep)
                } catch (err) {
                    // 에러 발생 시 예외 던지기
                    buildDescription '[Error Occurred(WAS Server Backup Failed) :: ' + err.getMessage() + ']' // 에러 발생 시 설명 추가
                    throw new Exception(err.getMessage()) 
                }
                // 배포 경로에서 백업 파일 삭제
                sshCommand remote: remote, command: '/usr/bin/rm -rf ' + was_deploy_path + '/' + build_file
            }
            
            // WAS 서버 체크 단계
            stage('WAS-' + inx + ' Check') {
                try {
                    // WAS 서버 프로세스 확인
                    def pid = sshCommand remote: remote, command: 'ps -ef | grep java | grep ‘' + pjtName + '‘ | awk ‘{print $2}’'
                    echo 'WAS-' + inx + ' Check :: [' + pid + ']' 
                    // 프로세스 ID 출력
                    if (pid == null || pid == '' || pid.length() == 0) {
                        // 프로세스가 없으면 예외 발생
                        throw new Exception('WAS-' + inx + ' Service Failed') 
                    }
                } catch (err) {
                    // 에러 발생 시 예외 던지기
                    buildDescription '[Error Occurred(WAS Check Failed) :: ' + err.getMessage() + ']' // 에러 발생 시 설명 추가
                    throw new Exception(err.getMessage()) 
                }
            }
        }
    }
    
	// 보고서 서버 배포 및 백업 단계에 사용할 자격 증명 설정
	withCredentials([usernamePassword(credentialsId: 'jeus', passwordVariable: 'password', usernameVariable: 'userName')]) {
	    remote.name = 'jeus' // 원격 서버 이름 설정
	    remote.user = userName // 원격 서버 사용자 이름 설정
	    remote.password = password // 원격 서버 비밀번호 설정
	    def ozr_deploy_path = '/app/jeus/online/' + mwInsName + '/WEB-INF/repository_files' // ozR 배포 경로 설정
	    def ozr_file = pjtName + '-ozr.tgz' // 배포할 ozR 파일 이름 설정
	    
	    // ozR 서버 IP 리스트를 순회하며 배포 진행
	    for (int inx = 1; inx <= ozIpList.size(); inx++) {
	        // IP 주소가 비어있는지 확인하고 비어있으면 건너뜀
	        if (ozIpList[inx - 1] == '' || ozIpList[inx - 1].length() == 0) {
	            continue
	        }
	        
	        remote.host = ozIpList[inx - 1] // 현재 순번의 ozR 서버 IP 주소 설정
            
            // 보고서 서버 배포 단계
            stage('RPT-' + inx + ' Deploy') {
                try {
                    // 배포 경로가 존재하는지 확인
                    def ozDeployPathRes = sshCommand remote: remote, command: 'test -d ' + ozr_deploy_path + ' && echo 1 || echo 2'
                    if (ozDeployPathRes == '2') {
                        // 경로가 없으면 생성
                        sshCommand remote: remote, command: 'mkdir -p ' + ozr_deploy_path
                    }
                    // 기존 파일 삭제
                    sshCommand remote: remote, command: '/usr/bin/rm -rf ' + ozr_deploy_path + '/' + pjtName + '/*'
                    // 빌드 파일 업로드
                    sshPut remote: remote, from: workspace + '/target/' + ozr_file, into: ozr_deploy_path + '/'
                    // 빌드 파일 압축 해제
                    sshCommand remote: remote, command: '/usr/bin/tar -xvf ' + ozr_deploy_path + '/' + ozr_file + ' -C ' + ozr_deploy_path
                    // 업로드한 빌드 파일 삭제
                    sshCommand remote: remote, command: '/usr/bin/rm -rf ' + ozr_deploy_path + '/' + ozr_file
                } catch (err) {
                    // 에러 발생 시 예외 던지기
                    buildDescription '[Error Occurred(Report Deploy Failed) :: ' + err.getMessage() + ']' // 에러 발생 시 설명 추가
                    throw new Exception(err.getMessage()) 
                }
            }
        }
    }
    
    // 젠킨스 빌드 파일 정리 단계
    stage('Cleanup') {
        // 작업 공간의 임시 파일 삭제
        dir(‘${env.WORKSPACE}@tmp’) {
            deleteDir() // 임시 디렉토리 삭제
        }
    }
    
    // 완료 단계
    stage('Complete') {
        echo 'Job Complete' // 작업 완료 메시지 출력
    }
}