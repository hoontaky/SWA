# tar
tar 파일 만들기
tar -cf <fildName> <targetFileName>
: tar -cf temp.tar ./tmp1.txt

tar 파일 내용 보기
tar -tvf <fileName>
: tar -tvf temp.tar

tar 파일에 파일 추가
tar -rf <tarFileName> <targetFileName>
: tar -rf temp.tar temp2.txt

묶음/압축
tar -cvzf <fileName> <path>
: tar -cvzf test.tar.gz /app/sw/repository/
: 동일 경로에서 진행 시, 마지막에 '|| true' 추가 필요

묶음/압축 해지
tar -xvzf <fileName>
: tar -xvzf test.tar.gz

특정 경로 묶음/압축 해지
tar -xvzf <fileName> -C /path
: tar -xvzf test.tar.gz -C /app/sw/repository/

# sh
shell 파일 실행 시, true 붙여주는 것이 좋음
: sh ./start.sh || true

# 업로드 경로 찾을 때(Linux)
du --max-depth 1 -h(k/m도 가능)
: du --max-depth 1 -h /data

# 하위 경로 용량 확인
du -sh *

# 업로드 경로 찾을 때(Unix)
du -k | perl -ne 'prin if (tr#/#/# ==1)'

# 스토리지 찾을 때
df -h

# 폴더 경로 보고자 할 때
tree <path> -L <level>
: tree /data -L 3

# rpm(yum) 설치된 패키지 확인
rpm -qa | grep <package>
: rpm -qa | grep nmap >> nmap-ncat-6.40-19.amzn2.0.1.x86_64

which <package>
: which nc >> /usr/bin/nc

# 방화벽 확인
nc -w 1 -i 1 -v <ip> <port>
: nc -w 1 -i 1 -v 192.168.0.1 8090

# head/tail
head -n <headLvel> <fileName>
: head -n 3 aa.txt

head -n <headLvel> <fileName> | tail -n <tailLevel>
: head -n 3 aa.txt | tail -n 2

cat << EOF >> aa.txt
> 1
> 2
> 3
> 4
> 5
> EOF

head -n 3 aa.txt | tail -n 2 >> 2 3
>> aa.txt 파일의 위의 3줄만 갖고 와서 마지막 2번째 줄만 표시

# 그룹 생성
groupadd <groupName>
: groupadd webadm

# 유저 생성
useradd -g <groupName> <userName>
: useradd -g webadm uapproval

# CPU 사용률
top -bn1 | grep "Cpu(s)" | awk '{print("CPU Usage : %.1f%%\n", 100-$8)}'

#jstat 사용법
jstat -gcutil -h 20 ${PID} 2000 >> 상위 20개만 XX 2초 간격으로 %로 표출
jstat -gc -h 20 ${PID} 2000 >>    상위 20개만 XX 2초 간격으로 숫차로 표출

# find
경로에서 동일한 확장자의 파일을 찾아서 특정 파일을 제외한 나머지 검색
find <path> -type f -name 'application-*.yml' ! -name 'application-dev.yml'

경로에서 동일한 확장자의 파일을 찾아서 특정 파일을 제외한 나머지는 삭제
find <path> -type f -name 'application-*.yml' ! -name 'application-dev.yml' -delete

경로에서 하위 첫 번째 폴더 명만 조회(베이스 경로인 ./ 제외)
find <path> -maxdepth 1 ! -name .
find <path> -maxdepth 1 ! -name . | cut -c 3-